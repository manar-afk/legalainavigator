# =========================================================
# Legal Information Navigator - Environment Configuration
# =========================================================

# Google Cloud / Gemini API Configuration
# Option A: Google GenAI Developer API Key
GEMINI_API_KEY=

# Option B: Google Cloud Vertex AI (Service Account ADC)
USE_VERTEX_AI=false
GOOGLE_CLOUD_PROJECT=
VERTEX_AI_LOCATION=us-central1

# Google GenAI Models (Configurable without changing codebase)
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Application Server
HOST=0.0.0.0
PORT=8000
